#!/usr/bin/env bash
# publish : put the catalog and the endpoint on tiesapi.com, then check it from the outside.
#   1 ./test.sh must pass (nothing goes out broken)
#   2 bundle endpoint/lambda_function.py + catalog/ into one zip
#   3 aws lambda update-function-code (function ties-api, us-east-1); wait until it is live
#   4 GET https://tiesapi.com/catalog/<entry> for every entry here and compare the sha256
# usage : bin/publish [--dry-run] [--from <catalog dir>]
#   --dry-run             test and bundle only, nothing sent
#   --from <dir>          take the entries from a worldline-style catalog: <dir>/<type>/README.md becomes entry <type>,
#                         byte-exact (default: catalog/entries/ here). Nothing is copied into this repository.
# needs : zip, aws (logged in), curl, jq, shasum
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
FN=ties-api; REGION=us-east-1; LIVE=https://tiesapi.com; DRY=0; FROM=""
while [ $# -gt 0 ]; do case "$1" in --dry-run) DRY=1; shift;; --from) FROM="$2"; shift 2;; *) echo "publish: unknown argument $1" >&2; exit 2;; esac; done
[ -z "$FROM" ] || [ -d "$FROM" ] || { echo "publish: no such catalog dir: $FROM" >&2; exit 2; }
for t in zip aws curl jq shasum; do command -v "$t" >/dev/null || { echo "publish: needs $t" >&2; exit 2; }; done

B="$(mktemp -d)"
echo "== 1 test"
./test.sh > "$B/test.txt" 2>&1; tail -1 "$B/test.txt"
grep -q ' 0 failed' "$B/test.txt" || { grep FAIL "$B/test.txt"; echo "publish: test.sh failed, nothing sent" >&2; exit 1; }

echo "== 2 bundle"
cp endpoint/lambda_function.py "$B/"
mkdir -p "$B/catalog/entries"; cp catalog/keywords.tsv "$B/catalog/"
[ -d catalog/contracts ] && cp -R catalog/contracts "$B/catalog/"   # the contract pages, GET /api/<name>
if [ -n "$FROM" ]; then
  for d in "$FROM"/*/; do d="${d%/}"; n="$(basename "$d")"
    [ -L "$d" ] || [ -L "$d/README.md" ] && { echo "   skip $n (symlink)"; continue; }   # only real files under the catalog go out
    [ -f "$d/README.md" ] || continue
    printf '%s' "$n" | grep -Eq '^[A-Za-z0-9_-][A-Za-z0-9._-]*$' || { echo "   skip $n (name)"; continue; }
    cp "$d/README.md" "$B/catalog/entries/$n"; done
else
  for f in catalog/entries/*; do [ -f "$f" ] && cp "$f" "$B/catalog/entries/"; done
fi
SRC="${FROM:-catalog/entries}"
(cd "$B" && zip -qr bundle.zip lambda_function.py catalog && unzip -Z1 bundle.zip | grep -v '/$' | sed 's/^/   /')
for f in "$B"/catalog/entries/*; do [ -f "$f" ] && echo "   $LIVE/catalog/$(basename "$f")  sha256:$(shasum -a 256 "$f" | cut -c1-64)"; done
[ $DRY -eq 1 ] && { echo "publish: dry run, nothing sent ($B/bundle.zip)"; exit 0; }

echo "== 3 send to $FN ($REGION)"
aws lambda update-function-code --function-name "$FN" --region "$REGION" --zip-file "fileb://$B/bundle.zip" --query 'CodeSha256' --output text || exit 1
for i in $(seq 1 30); do
  s="$(aws lambda get-function-configuration --function-name "$FN" --region "$REGION" --query LastUpdateStatus --output text)"
  [ "$s" = Successful ] && break; [ "$s" = Failed ] && { echo "publish: update failed" >&2; exit 1; }; sleep 1
done
echo "   live"

echo "== 4 check $LIVE"
bad=0
for f in "$B"/catalog/entries/*; do
  [ -f "$f" ] || continue; n="$(basename "$f")"
  here="sha256:$(shasum -a 256 "$f" | cut -c1-64)"
  there="$(curl -s --max-time 15 "$LIVE/catalog/$n" | jq -r .sha256)"
  if [ "$here" = "$there" ]; then echo "   ok   $LIVE/catalog/$n  $here"; else echo "   FAIL $LIVE/catalog/$n  here $here  there $there"; bad=1; fi
done
ct="$(curl -s --max-time 15 -o /dev/null -w '%{content_type}' -H 'Accept: text/html' "$LIVE/")"
case "$ct" in text/html*) echo "   ok   $LIVE/ is a page for a browser ($ct)";; *) echo "   FAIL $LIVE/ for a browser: $ct"; bad=1;; esac
[ $bad -eq 0 ] && echo "publish: done" || { echo "publish: live site does not match" >&2; exit 1; }
