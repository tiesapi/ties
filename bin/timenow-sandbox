#!/usr/bin/env bash
# timenow-sandbox : SOP lambda. One valid call produces one timenow sandbox under <worldline>/days/.
# authority : theisen-api (doctortheisen's name, "until i name otherwise")
# sop       : steps 1-3 are doctortheisen's words of 2026-10-24 00:57 PDT,
#             written out in /Users/doctortheisen/worldline/days/20261024/T005803PDT/sandbox/contents/SOP.md
# catalog id: [[ his ]]
#
# usage : timenow-sandbox [--root <worldline>] [--criterion <text>] [--description <file>] [--by <name>]
#   --root        the target worldline. default /Users/<whoami>/worldline
#   --criterion   the acceptance criterion, one line. default "[[ ]]"
#   --description a file whose text goes under "## description". default "[[ ]]"
#   --by          who is responsible for the rating form. default whoami
# out   : one Knuth list (JSON list of lists, tag first) on stdout; the sandbox path is in it
# exit  : 0 ok | 2 invalid call (not the owner's worldline, or no days/) | 3 path exists at this second | 4 README not written | 5 newest sandbox is under 100 s old
set -euo pipefail

ROOT=""; CRIT="[[ ]]"; DESC_FILE=""; BY=""
while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="$2"; shift 2;;
    --criterion) CRIT="$2"; shift 2;;
    --description) DESC_FILE="$2"; shift 2;;
    --by) BY="$2"; shift 2;;
    -h|--help) sed -n 2,16p "$0"; exit 0;;
    *) echo "timenow-sandbox: unknown argument $1" >&2; exit 2;;
  esac
done
CALL="timenow-sandbox${ROOT:+ --root $ROOT}${DESC_FILE:+ --description $DESC_FILE}${BY:+ --by $BY} --criterion \"$CRIT\""

# ---- step 1: valid call -----------------------------------------------------
# his words: "validate the system shell call `whoami` matches '/Users/<username>/worldline/' of target worldline, bolstered later"
U="$(whoami)"
if [ "$(uname)" = Darwin ]; then STAT_OWNER() { /usr/bin/stat -f %Su "$1"; }; DATE() { /bin/date "$@"; }; else STAT_OWNER() { stat -c %U "$1"; }; DATE() { date "$@"; }; fi
[ -n "$ROOT" ] || ROOT="/Users/$U/worldline"
ROOT="${ROOT%/}"
if [ ! -d "$ROOT/days" ]; then
  echo "timenow-sandbox: invalid call: $ROOT/days is not a directory" >&2; exit 2
fi
OWNER="$(STAT_OWNER "$ROOT" 2>/dev/null || echo "?")"
if [ "$OWNER" != "$U" ]; then
  echo "timenow-sandbox: invalid call: whoami=$U but $ROOT is owned by $OWNER" >&2; exit 2
fi
[ -n "$BY" ] || BY="$U"

# timenow, taken once, by the api, at the time of the call
EPOCH="$(DATE +%s)"
if [ "$(uname)" = Darwin ]; then AT() { DATE -r "$EPOCH" "$@"; }; else AT() { DATE -d @"$EPOCH" "$@"; }; fi
D="$(AT +%Y%m%d)"
T="$(AT +T%H%M%S%Z)"
LOCAL="$(AT "+%a %b %d %T %Z %Y")"
ISO="$(AT "+%Y-%m-%dT%H:%M:%S%z")"
UTC="$(AT -u "+%Y-%m-%dT%H:%M:%SZ")"
HOST="$(hostname -s 2>/dev/null || hostname)"

# ---- step 2: open the path --------------------------------------------------
# his words: "open one path of folders to represent one timestamped sandbox by appended to ~/worldline/days/<yyyymmdd>/T<HMSZ>/sandbox/contents"
S="$ROOT/days/$D/$T"
if [ -e "$S" ]; then
  echo "timenow-sandbox: $S exists; one sandbox per second" >&2; exit 3
fi
# his word, 2026-10-23 21:50 PDT: sandboxes on one worldline at least 100 s apart. Read from the folder names.
sod() { echo $(( 10#${1:1:2}*3600 + 10#${1:3:2}*60 + 10#${1:5:2} )); }
NOW_SOD="$(sod "$T")"
if [ "$(uname)" = Darwin ]; then YD="$(DATE -r $((EPOCH-86400)) +%Y%m%d)"; else YD="$(DATE -d @$((EPOCH-86400)) +%Y%m%d)"; fi
for d in "$ROOT/days/$D"/T[0-9][0-9][0-9][0-9][0-9][0-9]*/ "$ROOT/days/$YD"/T[0-9][0-9][0-9][0-9][0-9][0-9]*/; do
  [ -d "$d" ] || continue; b="$(basename "$d")"
  case "$d" in "$ROOT/days/$D/"*) diff=$(( NOW_SOD - $(sod "$b") ));; *) diff=$(( NOW_SOD + 86400 - $(sod "$b") ));; esac
  if [ $diff -ge 0 ] && [ $diff -lt 100 ]; then
    echo "timenow-sandbox: $d opened $diff s ago; one sandbox per 100 s" >&2; exit 5
  fi
done
mkdir -p "$S/sandbox/contents"
printf '.DS_Store\n.remember/\n' > "$S/.gitignore"

# ---- step 3: README.md -------------------------------------------------------
# his words: 'heading states "# todo" and below contains a checkbox for acceptance criterion with memo stating that
#             description appears below. metadata in the file to allow traceability.'
SELF_SHA="$(shasum -a 256 "$0" | cut -c1-64)"
if [ -n "$DESC_FILE" ] && [ -f "$DESC_FILE" ]; then DESC="$(cat "$DESC_FILE")"; else DESC="[[ ]]"; fi
{
  printf '# todo\n'
  printf -- '- [ ] %s\n' "$CRIT"
  printf 'Description appears below.\n\n'
  printf '## description\n%s\n\n' "$DESC"
  # his wording, 2026-10-23 21:58 PDT, /Users/doctortheisen/worldline/days/20261022/T215058PDT/README.md
  printf '## rating form\n'
  printf 'I am root user and this is my worldline. Hence, I (%s) am responsible for this rating form. Agents do not fill it out for me.\n\n' "$BY"
  printf 'XOR\n- [ ] success\n- [ ] failure\n\ncl.\n\nmemo.\n\n'
  # his form, 2026-10-22 12:58 PDT, /Users/doctortheisen/worldline/days/20261022/T125855PDT/README.md
  printf '## validation\n### passphrase nonce\n[[ ]]\n\n### domains\ninclude timestamp and pid or uuid toward provenance.\n[[ ]]\n\n'
  printf '## metadata\n'
  printf '%s\n%s\n%s/sandbox/contents\n\n' "$LOCAL" "$U" "$S"
  printf 'clock: %s (%s)\n' "$ISO" "$UTC"
  printf 'device: %s\n' "$HOST"
  printf 'worldline: %s\n' "$ROOT"
  printf 'call: %s\n' "$CALL"
  printf 'lambda: timenow-sandbox sha256:%s\n' "$SELF_SHA"
  printf 'sop: /Users/doctortheisen/worldline/days/20261024/T005803PDT/sandbox/contents/SOP.md\n'
} > "$S/README.md"
[ -s "$S/README.md" ] || { echo "timenow-sandbox: README.md not written" >&2; exit 4; }
README_SHA="$(shasum -a 256 "$S/README.md" | cut -c1-64)"

# ---- return: one Knuth list, tag first --------------------------------------
j() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
printf '["SANDBOX",["WHO","%s"],["WHEN","%s"],["WHERE","%s"],["DEVICE","%s"],["WORLDLINE","%s"],["README","sha256:%s"],["LAMBDA","timenow-sandbox","sha256:%s"],["CALL","%s"]]\n' \
  "$(j "$U")" "$ISO" "$(j "$S")" "$(j "$HOST")" "$(j "$ROOT")" "$README_SHA" "$SELF_SHA" "$(j "$CALL")"
